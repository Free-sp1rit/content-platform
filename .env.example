APP_ENV=local

HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

DATABASE_URL=postgres://postgres:postgres@localhost:5432/content_platform?sslmode=disable
# Must be greater than zero; zero would make database/sql connections unlimited.
DATABASE_MAX_OPEN_CONNS=20
# Zero keeps no idle connections; must not exceed DATABASE_MAX_OPEN_CONNS.
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_PING_TIMEOUT=3s

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PING_TIMEOUT=2s

# Development-only placeholder; never reuse it in production.
# Production must inject a distinct CSPRNG-generated secret from a secret manager.
AUTH_JWT_SECRET=development-only-jwt-secret-change-me-0123456789abcdef
AUTH_JWT_ISSUER=content-platform
AUTH_JWT_AUDIENCE=content-platform-api
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h

# Choose 10..15 only while the users table is empty. After the first user,
# keep this immutable and identical across every instance and rolling deploy.
# A future change needs a separate controlled password-reset/credential-upgrade
# design; bcrypt cost cannot be raised offline without the plaintext password.
AUTH_BCRYPT_COST=12

LOG_LEVEL=info
LOG_FORMAT=json
